# Ollama password classifier
PASSWORD_CLASSIFIER_BASE_URL=http://host.docker.internal:11434
PASSWORD_CLASSIFIER_MODEL=qwen2.5:1.5b
PASSWORD_CLASSIFIER_TIMEOUT_SECONDS=120

# ServiceNow
SERVICENOW_INSTANCE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
