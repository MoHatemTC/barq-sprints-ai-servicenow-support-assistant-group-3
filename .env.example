# ---- Qdrant (vector store, S2.1/S2.2) ----
# Get these from your Qdrant Cloud cluster dashboard
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=kb_articles

# ---- Embeddings (S2.1) ----
# Use the lite LLM endpoint provided by Sprints with a model like `gemini-embedding-2`
GEMINI_API_KEY=

# ---- Chunking parameters (S2.1) - adjust without touching the code ----
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ---- Retrieval (S2.2) ----
RETRIEVAL_SCORE_THRESHOLD=0.65
RETRIEVAL_TOP_K=3

# ---- Agent / LLM (S2.4) ----
# OpenAI-compatible endpoint; credentials come from the environment, never from the repo
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
