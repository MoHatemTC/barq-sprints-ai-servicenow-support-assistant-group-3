# Copy to .env and fill in. NEVER commit .env
SERVICENOW_INSTANCE_URL=https://dev420846.service-now.com
SERVICENOW_USER=
SERVICENOW_PASSWORD=

# Knowledge base sys_id (from the KB URL Ashar shared)
SERVICENOW_KB_SYS_ID=cdda7be82f9b07502e0e5b707fa4e31f

# Safety gate: keep this "false" while testing against the shared dev
# instance. When false, update_incident() validates and logs writes but
# never sends them — so running the agent can't leave work notes on a
# teammate's incident by accident. Set "true" only when you deliberately
# want live writes.
SERVICENOW_LIVE_WRITES=false

# Used only by PoCs/check_connection.py
KB_PROBE_QUERY=password
TEST_INCIDENT_NUMBER=INC0000001

# LiteLLM gateway (for later sprints — not used by S2.3)
LITELLM_BASE_URL=https://management.sprints.ai/litellm
LITELLM_API_KEY=
