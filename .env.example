PASSWORD_CLASSIFIER_MODEL=qwen2.5:1.5b
PASSWORD_CLASSIFIER_TIMEOUT_SECONDS=120.0

# ServiceNow
SERVICENOW_INSTANCE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
SERVICENOW_RUNBOOK_TABLE=x_2215697_ai_ser_0_runbook_upload
SERVICENOW_ATTACHMENT_MAX_BYTES=26214400
SERVICENOW_RUNBOOK_MAX_PAGES=50

# Qdrant
QDRANT_URL=
QDRANT_API_KEY=
