# ---- ServiceNow -------------------------------------------------------------
SERVICE_NOW_URL=
SERVICE_NOW_USERNAME=
SERVICE_NOW_PASSWORD=

# ---- Qdrant -----------------------------------------------------------------
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=

# ---- Embeddings -------------------------------------------------------------
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=

# ---- Chunking (measured in characters) -------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ---- Optional: tune to match your instance / existing Qdrant collection -----
# Comma-separated workflow_state values treated as "published" (default: published)
# SERVICE_NOW_PUBLISHED_STATES=published
# Comma-separated kb_knowledge_base sys_ids to restrict ingestion (default: all)
# SERVICE_NOW_KB_SYS_IDS=
# SERVICE_NOW_TABLE=kb_knowledge
# Payload key that holds the chunk text (must match what searchKB reads)
# QDRANT_TEXT_FIELD=text
# Set only if the existing collection uses a NAMED vector
# QDRANT_VECTOR_NAME=
# QDRANT_DISTANCE=Cosine
# OpenAI-compatible embeddings endpoint
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_INCLUDE_TITLE=true

# ---- Optional: API protection ----------------------------------------------
# If set, /kb/sync and /kb/sync/{sys_id} require header X-API-Key
# API_AUTH_TOKEN=
# If set, enables POST /kb/events (header X-Webhook-Secret). Unset = disabled.
# WEBHOOK_SECRET=

# ---- Optional: sync behaviour ----------------------------------------------
# SYNC_STATE_PATH=.state/last_sync.json
# SYNC_INITIAL_LOOKBACK_HOURS=24
# LOG_LEVEL=INFO
