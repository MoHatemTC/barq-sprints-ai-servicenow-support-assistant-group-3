# Copy to .env and fill in. NEVER commit .env (it is git-ignored).

# --- Required ---
LLM_API_KEY=replace-me
LLM_MODEL=replace-me            # e.g. the chat model name your endpoint serves

# --- Endpoint (optional for the provider default, required for any
#     OpenAI-compatible gateway: Azure/OpenAI-compatible proxy, vLLM, Groq, OpenRouter, ...) ---
LLM_BASE_URL=

# --- Optional tuning ---
LLM_TEMPERATURE=0               # set to "none" for models that reject a temperature parameter
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
AGENT_MAX_ITERATIONS=5
